<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Background palette ── -->
    <Color x:Key="ColorBg0">#1e1e2e</Color>
    <Color x:Key="ColorBg1">#2d2d44</Color>
    <Color x:Key="ColorBg2">#3d3d5c</Color>
    <Color x:Key="ColorBg3">#4a4a6a</Color>

    <!-- ── Accent ── -->
    <Color x:Key="ColorAccent">#4a9eff</Color>
    <Color x:Key="ColorAccentDark">#2d7fd9</Color>
    <Color x:Key="ColorCyan">#00d4ff</Color>

    <!-- ── Text ── -->
    <Color x:Key="ColorTextPrimary">#e0e0ff</Color>
    <Color x:Key="ColorTextSecondary">#a0a0c0</Color>
    <Color x:Key="ColorTextMuted">#606080</Color>

    <!-- ── Risk ── -->
    <Color x:Key="ColorRiskLow">#4ade80</Color>
    <Color x:Key="ColorRiskMedium">#facc15</Color>
    <Color x:Key="ColorRiskHigh">#f97316</Color>
    <Color x:Key="ColorRiskCritical">#dc2626</Color>

    <!-- ── State ── -->
    <Color x:Key="ColorSuccess">#22c55e</Color>
    <Color x:Key="ColorError">#ef4444</Color>
    <Color x:Key="ColorWarning">#f59e0b</Color>
    <Color x:Key="ColorInfo">#60a5fa</Color>

    <!-- ── Brushes ── -->
    <SolidColorBrush x:Key="BrushBg0"         Color="{StaticResource ColorBg0}"/>
    <SolidColorBrush x:Key="BrushBg1"         Color="{StaticResource ColorBg1}"/>
    <SolidColorBrush x:Key="BrushBg2"         Color="{StaticResource ColorBg2}"/>
    <SolidColorBrush x:Key="BrushBg3"         Color="{StaticResource ColorBg3}"/>
    <SolidColorBrush x:Key="BrushAccent"      Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="BrushAccentDark"  Color="{StaticResource ColorAccentDark}"/>
    <SolidColorBrush x:Key="BrushCyan"        Color="{StaticResource ColorCyan}"/>
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextMuted"   Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="BrushRiskLow"     Color="{StaticResource ColorRiskLow}"/>
    <SolidColorBrush x:Key="BrushRiskMedium"  Color="{StaticResource ColorRiskMedium}"/>
    <SolidColorBrush x:Key="BrushRiskHigh"    Color="{StaticResource ColorRiskHigh}"/>
    <SolidColorBrush x:Key="BrushRiskCritical" Color="{StaticResource ColorRiskCritical}"/>
    <SolidColorBrush x:Key="BrushSuccess"     Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushError"       Color="{StaticResource ColorError}"/>
    <SolidColorBrush x:Key="BrushWarning"     Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushInfo"        Color="{StaticResource ColorInfo}"/>

    <!-- Transparent -->
    <SolidColorBrush x:Key="BrushTransparent" Color="Transparent"/>

</ResourceDictionary>
