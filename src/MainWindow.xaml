<Window x:Class="UaskusTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UaskusTweaks.ViewModels"
        xmlns:models="clr-namespace:UaskusTweaks.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Uaskus Tweaks v2.1"
        Width="1220" Height="820"
        MinWidth="920" MinHeight="620"
        Background="{StaticResource BrushBg0}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Log level → foreground brush -->
        <sys:String x:Key="InfoColor">#60a5fa</sys:String>
        <sys:String x:Key="SuccessColor">#22c55e</sys:String>
        <sys:String x:Key="WarningColor">#f59e0b</sys:String>
        <sys:String x:Key="ErrorColor">#ef4444</sys:String>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type models:LogEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                           Foreground="{StaticResource BrushTextMuted}"
                           FontSize="11" FontFamily="Consolas"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding LogLevel}"
                           FontSize="11" FontFamily="Consolas"
                           FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushInfo}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2"
                           Text="{Binding Message}"
                           Foreground="{StaticResource BrushTextPrimary}"
                           FontSize="11" FontFamily="Consolas"
                           TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <!-- Tweak row template -->
        <DataTemplate x:Key="TweakRowTemplate" DataType="{x:Type vm:TweakViewModel}">
            <Border Margin="0,1"
                    Padding="10,7"
                    Background="{StaticResource BrushBg1}"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BrushBg2}"
                    CornerRadius="4">
                <Border.ToolTip>
                    <ToolTip Content="{Binding Tooltip}"/>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>

                    <!-- Toggle switch -->
                    <ToggleButton Grid.Column="0"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  VerticalAlignment="Center"/>

                    <!-- Name + Description -->
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text=" 🔒"
                                       Foreground="{StaticResource BrushWarning}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding IsAdminRequired, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text=" ↺"
                                       Foreground="{StaticResource BrushWarning}"
                                       FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Risk badge -->
                    <Border Grid.Column="2"
                            Background="{Binding RiskColor}"
                            CornerRadius="3"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RiskText}"
                                   Foreground="#1e1e2e"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </Border>

                    <!-- Restart icon -->
                    <TextBlock Grid.Column="3"
                               Text="↺"
                               Foreground="{StaticResource BrushWarning}"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               ToolTip="Requires restart">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RequiresRestart}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- Title bar -->
            <RowDefinition Height="*"/>    <!-- Main content -->
            <RowDefinition Height="180"/>  <!-- Log panel -->
            <RowDefinition Height="38"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════════════════
             TITLE BAR
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushBg0}"
                BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource BrushCyan}" Margin="0,0,8,0"/>
                    <TextBlock Text="UASKUS TWEAKS"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text=" v2.1"
                               FontSize="11"
                               Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="2,2,0,0"/>
                    <!-- Admin badge -->
                    <Border Margin="16,0,0,0" Padding="6,2" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#14532d"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                        <Setter Property="Background" Value="#7f1d1d"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="🛡 ADMIN"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushRiskLow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                            <Setter Property="Text" Value="⚠ NO ADMIN"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- Window buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="─" Width="40" Height="30" FontSize="14"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="MinimizeButton_Click"/>
                    <Button Content="□" Width="40" Height="30" FontSize="14"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="MaximizeButton_Click"/>
                    <Button Content="✕" Width="40" Height="30" FontSize="14"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource BrushTextSecondary}"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             MAIN CONTENT
        ══════════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>      <!-- Left sidebar with tabs -->
                <ColumnDefinition Width="*"/>        <!-- Main content area -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR - Category Buttons -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushBg1}"
                    BorderBrush="{StaticResource BrushBg2}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Search bar -->
                    <Border DockPanel.Dock="Top"
                            Background="{StaticResource BrushBg0}"
                            Padding="12,8"
                            BorderBrush="{StaticResource BrushBg2}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBox x:Name="SearchBox"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource BrushBg2}"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     BorderBrush="{StaticResource BrushBg3}"
                                     Padding="10,5"
                                     FontSize="11"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="🔍 Search…"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontSize="11"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Category buttons list -->
                    <ScrollViewer DockPanel.Dock="Bottom"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="CategoryButtonsItemsControl" ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TweakCategoryViewModel}">
                                    <Button Click="CategoryButton_Click"
                                            Tag="{Binding}"
                                            Padding="8,6"
                                            Margin="5,3"
                                            Height="75"
                                            Cursor="Hand">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushBg3}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                <EventSetter Event="MouseEnter" Handler="CategoryButton_MouseEnter"/>
                                                <EventSetter Event="MouseLeave" Handler="CategoryButton_MouseLeave"/>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Icon}" FontSize="22" TextAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" TextAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="8" TextAlignment="Center" Margin="0,2,0,0" Opacity="0.7">
                                                <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                                                <Run Text="/"/>
                                                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT CONTENT AREA -->
            <DockPanel Grid.Column="1">
                <!-- Category header -->
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource BrushBg0}"
                        Padding="14,8"
                        BorderBrush="{StaticResource BrushBg2}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="👁 Preview"
                                    Command="{Binding PreviewCommand}"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="📋 Export Log"
                                    Command="{Binding ExportLogCommand}"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="✓ Select All"
                                    Command="{Binding SelectedCategory.SelectAllCommand}"
                                    Style="{StaticResource SmallButton}"
                                    Margin="0,0,8,0"/>
                            <Button Content="✕ Deselect All"
                                    Command="{Binding SelectedCategory.DeselectAllCommand}"
                                    Style="{StaticResource SmallButton}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock>
                                <Run Text="{Binding SelectedCategory.Icon}" FontSize="16"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedCategory.Name}"
                                     FontWeight="SemiBold"
                                     Foreground="{StaticResource BrushTextPrimary}"
                                     FontSize="14"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedCategory.Description}"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tweaks list -->
                <ScrollViewer DockPanel.Dock="Bottom"
                              VerticalScrollBarVisibility="Auto"
                              x:Name="TweakScroller">
                    <ItemsControl ItemsSource="{Binding FilteredTweaks}"
                                  ItemTemplate="{StaticResource TweakRowTemplate}"
                                  Margin="8,4"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ══════════════════════════════════════════════════════════════════
             LOG PANEL
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource BrushBg0}"
                BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top"
                        Padding="12,5"
                        Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBg2}"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Clear"
                                Style="{StaticResource SmallButton}"
                                Click="ClearLog_Click"/>
                        <TextBlock Text="📋 LOG OUTPUT"
                                   Foreground="{StaticResource BrushAccent}"
                                   FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="LogScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="8,4">
                    <ItemsControl x:Name="LogList"
                                  ItemsSource="{Binding LogEntries}"
                                  ItemTemplate="{StaticResource LogEntryTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════════════════
             STATUS BAR
        ══════════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource BrushBg1}"
                BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <!-- Apply button on the right -->
                <Button DockPanel.Dock="Right"
                        Content="▶ Apply Selected"
                        Command="{Binding ApplySelectedCommand}"
                        Style="{StaticResource SmallButton}"
                        Margin="0,0,12,0"
                        IsEnabled="{Binding CanApply}"/>
                
                <!-- Indeterminate progress while applying -->
                <ProgressBar DockPanel.Dock="Right"
                             Width="120" Height="4"
                             IsIndeterminate="{Binding IsApplying}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}"
                             Margin="0,0,12,0"/>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
