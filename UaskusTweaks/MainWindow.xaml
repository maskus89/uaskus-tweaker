<Window x:Class="UaskusTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UaskusTweaks.ViewModels"
        xmlns:models="clr-namespace:UaskusTweaks.Models"
        Title="Uaskus Tweaks"
        Width="1220" Height="820"
        MinWidth="920" MinHeight="620"
        Background="{StaticResource BrushBg0}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CategoryListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{StaticResource BrushBg2}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBg3}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="122"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource BrushBg3}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrushCyan}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="PrimaryApplyButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="MinWidth" Value="280"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <DataTemplate x:Key="LogEntryTemplate" DataType="{x:Type models:LogEntry}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                           Foreground="{StaticResource BrushTextMuted}" FontSize="11" FontFamily="Consolas"/>
                <TextBlock Grid.Column="1" Text="{Binding LogLevel}" FontSize="11"
                           FontFamily="Consolas" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushInfo}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Success}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Warning}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LogLevel.Error}">
                                    <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Message}"
                           Foreground="{StaticResource BrushTextPrimary}" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TweakRowTemplate" DataType="{x:Type vm:TweakViewModel}">
            <Border Margin="2,4" Padding="14,12" Background="{StaticResource BrushBg1}"
                    BorderThickness="1" BorderBrush="{StaticResource BrushBg2}" CornerRadius="8">
                <Border.ToolTip>
                    <ToolTip Content="{Binding Tooltip}"/>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="98"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ToggleButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Style="{StaticResource ToggleSwitchStyle}"/>
                        <TextBlock Text="SELECT" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource BrushTextPrimary}"
                                       FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="  Administrator access" Foreground="{StaticResource BrushWarning}"
                                       FontSize="10" VerticalAlignment="Center"
                                       Visibility="{Binding IsAdminRequired, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource BrushTextSecondary}"
                                   FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="Restart needed after applying" Foreground="{StaticResource BrushWarning}"
                                   FontSize="10" Margin="0,4,0,0"
                                   Visibility="{Binding RequiresRestart, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="CURRENTLY" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Border Background="{Binding StateColor}" CornerRadius="4" Padding="8,4" MinWidth="82">
                            <TextBlock Text="{Binding StateText}" Foreground="White" TextAlignment="Center"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="RISK" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <Border Background="{Binding RiskColor}" CornerRadius="4" Padding="8,4" MinWidth="72">
                            <TextBlock Text="{Binding RiskText}" Foreground="#1e1e2e" TextAlignment="Center"
                                       FontSize="9" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="104"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="128"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushBg0}" BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontSize="18" Foreground="{StaticResource BrushCyan}" Margin="0,0,8,0"/>
                    <TextBlock Text="UASKUS TWEAKS" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayVersion, StringFormat={} {0}}" FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                               VerticalAlignment="Center" Margin="2,2,0,0"/>
                    <Border Margin="16,0,0,0" Padding="7,3" CornerRadius="3" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#14532d"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                        <Setter Property="Background" Value="#7f1d1d"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓ Ready to make changes"/>
                                    <Setter Property="Foreground" Value="{StaticResource BrushRiskLow}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAdmin}" Value="False">
                                            <Setter Property="Text" Value="⚠ Restart as administrator"/>
                                            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="─" Width="40" Height="30" FontSize="14" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}" Click="MinimizeButton_Click"/>
                    <Button Content="□" Width="40" Height="30" FontSize="14" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}" Click="MaximizeButton_Click"/>
                    <Button Content="✕" Width="40" Height="30" FontSize="14" Background="Transparent"
                            BorderThickness="0" Foreground="{StaticResource BrushTextSecondary}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="2,0,14,0">
                    <TextBlock Text="1. CHOOSE A CATEGORY" Foreground="{StaticResource BrushAccent}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Start with Essential Tweaks if you are unsure."
                               Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
                <ListBox Grid.Column="1" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Style="{StaticResource CategoryListStyle}"
                         ItemContainerStyle="{StaticResource CategoryItemStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TweakCategoryViewModel}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="21" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="10.5" FontWeight="SemiBold"/>
                                    <TextBlock FontSize="9" Opacity="0.78" Margin="0,2,0,0">
                                        <Run Text="{Binding SelectedCount}"/>
                                        <Run Text=" selected"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushBg2}"
                    BorderThickness="0,0,1,0" Padding="14,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="EASY SETUP" Foreground="{StaticResource BrushAccent}"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="Choose one ready-made setup, or select changes yourself on the right."
                                   Foreground="{StaticResource BrushTextSecondary}" FontSize="10.5"
                                   TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <Button Command="{Binding GamingPresetCommand}" Style="{StaticResource PresetButton}">
                            <StackPanel>
                                <TextBlock Text="🎮 Gaming" FontWeight="SemiBold"/>
                                <TextBlock Text="Smoother games and lower delay" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PrivacyPresetCommand}" Style="{StaticResource PresetButton}">
                            <StackPanel>
                                <TextBlock Text="🛡 Privacy" FontWeight="SemiBold"/>
                                <TextBlock Text="Reduce tracking and diagnostics" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding MaxPerformanceCommand}" Style="{StaticResource PresetButton}">
                            <StackPanel>
                                <TextBlock Text="⚡ Performance" FontWeight="SemiBold"/>
                                <TextBlock Text="Make Windows feel faster" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExtremePerformanceCommand}" Style="{StaticResource PresetButton}">
                            <StackPanel>
                                <TextBlock Text="⚠ Extreme performance" FontWeight="SemiBold" Foreground="{StaticResource BrushWarning}"/>
                                <TextBlock Text="Experts only; includes risky changes" Foreground="{StaticResource BrushTextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                        <Separator Margin="0,5,0,10"/>
                        <TextBlock Text="SAFETY" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <CheckBox IsChecked="{Binding CreateRestorePoint}" Content="Create a restore point first" FontSize="11"/>
                        <TextBlock Text="Recommended. This gives Windows a recovery point before changes are made."
                                   Foreground="{StaticResource BrushTextMuted}" FontSize="9.5"
                                   TextWrapping="Wrap" Margin="22,4,0,10"/>
                        <Button Content="↶ Undo the last apply" Command="{Binding UndoLastApplyCommand}"
                                Style="{StaticResource SmallButton}" HorizontalContentAlignment="Left"/>
                        <Separator Margin="0,10"/>
                        <TextBlock Text="TOOLS" Foreground="{StaticResource BrushTextMuted}"
                                   FontSize="10" FontWeight="Bold" Margin="0,0,0,8"/>
                        <Button Content="Review selected changes" Command="{Binding PreviewCommand}"
                                Style="{StaticResource SmallButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button Content="Check what is already active" Command="{Binding RefreshTweakStatesCommand}"
                                Style="{StaticResource SmallButton}" HorizontalContentAlignment="Left" Margin="0,0,0,6"/>
                        <Button Content="Save activity report" Command="{Binding ExportLogCommand}"
                                Style="{StaticResource SmallButton}" HorizontalContentAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Background="{StaticResource BrushBg0}" Padding="16,10"
                        BorderBrush="{StaticResource BrushBg2}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource BrushTextPrimary}">
                                <Run Text="2. CHOOSE CHANGES  ·  " Foreground="{StaticResource BrushAccent}" FontWeight="Bold" FontSize="11"/>
                                <Run Text="{Binding SelectedCategory.Icon}" FontSize="16"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedCategory.Name}" FontWeight="SemiBold" FontSize="14"/>
                            </TextBlock>
                            <TextBlock Text="{Binding SelectedCategory.Description}" Foreground="{StaticResource BrushTextSecondary}"
                                       FontSize="10.5" Margin="0,3,0,0"/>
                            <TextBlock Text="Turn on SELECT for the changes you want. Green ‘Already on’ means Windows already uses that setting."
                                       Foreground="{StaticResource BrushTextMuted}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                            <Button Content="Select all in this category" Command="{Binding SelectedCategory.SelectAllCommand}"
                                    Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                            <Button Content="Clear this category" Command="{Binding SelectedCategory.DeselectAllCommand}"
                                    Style="{StaticResource SmallButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="TweakScroller">
                    <ItemsControl ItemsSource="{Binding CurrentTweaks}" ItemTemplate="{StaticResource TweakRowTemplate}" Margin="9,5"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BrushBg0}" BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,1,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="12,5" Background="{StaticResource BrushBg1}"
                        BorderBrush="{StaticResource BrushBg2}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Clear activity" Style="{StaticResource SmallButton}" Click="ClearLog_Click"/>
                        <TextBlock Text="ACTIVITY" Foreground="{StaticResource BrushAccent}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="10,5">
                    <ItemsControl ItemsSource="{Binding LogEntries}" ItemTemplate="{StaticResource LogEntryTemplate}"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource BrushBg1}" BorderBrush="{StaticResource BrushBg2}"
                BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="3. APPLY YOUR CHANGES" Foreground="{StaticResource BrushAccent}"
                               FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushTextSecondary}"
                               FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <ProgressBar Grid.Column="1" Height="5" IsIndeterminate="{Binding IsApplying}"
                             Visibility="{Binding IsApplying, Converter={StaticResource BoolToVis}}"
                             Margin="12,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="{Binding ApplyButtonText}" Command="{Binding ApplySelectedCommand}"
                        Style="{StaticResource PrimaryApplyButton}" IsEnabled="{Binding CanApply}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
